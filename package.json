{
  "name": "movie-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "docker:prod-up": "docker compose -f docker-compose.prod.yml up --build -d",
    "docker:prod-down": "docker compose -f docker-compose.prod.yml down",
    "docker:prod-build": "docker compose -f docker-compose.prod.yml build",
    "docker:prod-build-clean": "docker compose -f docker-compose.prod.yml build --no-cache"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "astro": "^7.3.2",
    "astro-icon": "^1.2.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0"
  }
}
