---
import "../style/reset.css";
import "../style/variabless.css";
import "../style/global.css";
import HeadContent from "../components/HeadContent.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  showHeader?: boolean;
  showFooter?: boolean;
  mainClass?: string;
  backgroundPriority?: any;
}

const { title, description, showHeader = true, showFooter = true, mainClass = "", backgroundPriority } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <HeadContent title={title} description={description} />
    {backgroundPriority && <link rel="preload" as="image" href={backgroundPriority.src} fetchpriority="high" />}
  </head>
  <body>
    <h1 class="sr-only">{title}</h1>
    <div class:list={["page-shell", { "page-shell--with-header": showHeader, "page-shell--with-footer": showFooter }]}>
      {showHeader && <Header />}
      <main class={mainClass}>
        <slot />
      </main>
      {showFooter && <Footer />}
    </div>
  </body>
</html>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .page-shell {
    min-width: 0;
    display: grid;
    grid-template-areas: "main";
  }

  main {
    grid-area: main;
    min-width: 0;
  }

  .page-shell > :global(.footer) {
    grid-area: footer;
  }

  :global(.page-shell:has(> .footer)) {
    grid-template-areas:
      "main"
      "footer";
    gap: var(--space-xl);
  }

  @media (width >= 48rem) {
    .page-shell.page-shell--with-header.page-shell--with-footer {
      grid-template-columns: 4rem minmax(0, 1fr);
      grid-template-areas:
        "header main"
        "header footer";
      column-gap: 1.5rem;
    }

    :global(.page-shell > .side-header) {
      grid-area: header;
    }
  }
</style>
