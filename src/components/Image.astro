---
import { Image } from "astro:assets";

interface Props {
  path: string;
  alt: string;
  size?: "w342" | "w500" | "w780" | "original";
  width?: number;
  height?: number;
  type?: "poster" | "logo";
  loading?: "lazy" | "eager";
  layout?: "constrained" | "full-width" | "none";
  className?: string;
}

const { path, alt = "", size = "w500", type = "none", loading = "lazy", layout = "full-width", width, height, className } = Astro.props;
const src = `https://image.tmdb.org/t/p/${type === "logo" ? "original" : size}${path}`;

const dims = type === "poster" ? { width: 500, height: 750 } : { width: width!, height: height! };
---

<Image src={src} alt={alt} {...dims} loading={loading} layout={layout} class={className} />
