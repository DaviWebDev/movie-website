---
import Layout from "../layouts/Layout.astro";
import MovieRow from "../components/home/MovieRow.astro";
import FeaturedBanner from "../components/home/FeaturedBanner.astro";
import { fetchHomeData, backdropMovieOptimized, movieComplements } from "../js/services/api.ts";
import { filterUniqueMovies } from "../js/helpers/utils.ts";

const dataMovies = await fetchHomeData();
const { genres, upcomingMovies, popularMovie, recentMovies } = dataMovies;
const { id, backdrop_path } = popularMovie;

const bannerBackdrop = await backdropMovieOptimized(backdrop_path);
const bannerComplements = await movieComplements(id);
const displayedMovieIds = new Set<number>();
const rows = [{ title: "New This Week", movies: recentMovies }, ...genres, { title: "Coming Soon", movies: upcomingMovies }].map((row) => ({
  ...row,
  movies: filterUniqueMovies(row.movies, displayedMovieIds).slice(0, 10),
}));
---

<Layout title="Home Movion" description="Welcome to Movion Home, check your favorite genres movies." mainClass="home-main">
  <FeaturedBanner data={popularMovie} bannerBackdrop={bannerBackdrop} complements={bannerComplements} />
  {rows.map((row, index) => (
    <MovieRow data={row} loading={index < 2 ? "eager" : "lazy"} />
  ))}
</Layout>

<style>
  :global(.home-main) {
    width: min(100%, 2100px);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }
</style>
