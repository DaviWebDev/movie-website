---
const { trailer } = Astro.props;
---

<section class="movie-trailer">
  {trailer ? (
    <iframe
      src={`https://www.youtube.com/embed/${trailer.key}`}
      title={trailer.name}
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
    ></iframe>
  ) : (
    <p class="movie-trailer__fallback">Trailer unavailable</p>
  )}
</section>

<style>
  .movie-trailer {
    width: min(100% - 2rem, 60rem);
    aspect-ratio: 16 / 9;
    height: auto;
    overflow: hidden;
    border-radius: 2rem;
  }

  .movie-trailer iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (width >= 64rem) {
    .movie-trailer {
      align-self: flex-start;
    }
  }
</style>
