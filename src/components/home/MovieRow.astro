---
import type { MovieRowData } from "../../types/tmdb";
import { Icon } from "astro-icon/components";
import Image from "../Image.astro";

interface Props {
  data: MovieRowData;
  loading?: "lazy" | "eager";
}

const { data, loading = "lazy" } = Astro.props;
---

<section class="movie-row" aria-label=`${data.title} row`>
  <div class="movie-row__header">
    <h2>{data.title}</h2>
    <a href="/see more" aria-label="See More" class="movie-row__more">
      <span class="movie-row__more-icon">
        <Icon name="expand_right" aria-hidden="true" focusable="false" />
      </span>
      <span class="movie-row__more-text" aria-hidden="true">
        See more
      </span>
    </a>
  </div>
  <div class="movie-row__carousel">
    <button type="button" class="movie-row__control movie-row__control--prev" aria-label="Previous movies" disabled>
      <Icon name="expand_right" aria-hidden="true" focusable="false" />
    </button>
    <div class="movie-row__grid">
      {data.movies.map(
        (movie) =>
          movie.poster_path && (
            <a href={`/${movie.title}`} aria-label={movie.title} class="movie-row__card">
              <Image path={movie.poster_path} alt={movie.title} type="poster" loading={loading} className="movie-row__poster-img" />
            </a>
          ),
      )}
    </div>
    <button type="button" class="movie-row__control movie-row__control--next" aria-label="Next movies">
      <Icon name="expand_right" aria-hidden="true" focusable="false" />
    </button>
  </div>
</section>

<style>
  .movie-row {
    min-width: 0;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: 0 1rem;
  }

  .movie-row__header {
    display: flex;
    justify-content: space-between;
  }

  .movie-row__header h2 {
    font-size: 1.5rem;
  }

  .movie-row__more {
    text-decoration: none;
    color: var(--white-color);
  }

  .movie-row__more-icon svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .movie-row__more-text {
    font-size: 1.2rem;
    display: none;
  }

  .movie-row__grid {
    min-width: 0;
    max-width: 100%;
    height: 100%;
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: clamp(var(--space-md), 2vw, var(--space-xl));
    padding: 1rem 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .movie-row__carousel {
    position: relative;
    min-width: 0;
    max-width: 100%;
  }

  .movie-row__control {
    display: none;
  }

  .movie-row__card {
    flex: 0 0 clamp(7rem, 14vw, 11rem);
    min-width: 0;
    aspect-ratio: 2 / 3;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: 0 0 8px 2px rgba(255, 255, 255, 0.2);
  }

  :global(.movie-row__poster-img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media (width >= 48rem) {
    .movie-row__header h2 {
      font-size: 1.8rem;
    }
    .movie-row__more-text {
      display: block;
    }

    .movie-row__more-icon {
      display: none;
    }

    .movie-row__control {
      position: absolute;
      top: 50%;
      z-index: 1;
      display: grid;
      place-items: center;
      width: 2.5rem;
      height: 2.5rem;
      border: 0;
      border-radius: 50%;
      color: var(--white-color);
      background: rgba(0, 0, 0, 0.75);
      transform: translateY(-50%);
      cursor: pointer;
    }

    .movie-row__control svg {
      width: 1.25rem;
      height: 1.25rem;
    }

    .movie-row__control--prev {
      left: 0.5rem;
    }

    .movie-row__control--prev svg {
      transform: rotate(180deg);
    }

    .movie-row__control--next {
      right: 0.5rem;
    }

    .movie-row__control:disabled {
      opacity: 0.35;
      cursor: default;
    }
  }

  @media (width >= 135rem) {
    .movie-row__grid {
      gap: 0;
      justify-content: space-around;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".movie-row__carousel").forEach((carousel) => {
    const grid = carousel.querySelector<HTMLElement>(".movie-row__grid");
    const previousButton = carousel.querySelector<HTMLButtonElement>(".movie-row__control--prev");
    const nextButton = carousel.querySelector<HTMLButtonElement>(".movie-row__control--next");

    if (!grid || !previousButton || !nextButton) return;

    const updateControls = () => {
      previousButton.disabled = grid.scrollLeft <= 0;
      nextButton.disabled = grid.scrollLeft + grid.clientWidth >= grid.scrollWidth - 1;
    };

    const scrollGrid = (direction: number) => {
      grid.scrollBy({ left: direction * grid.clientWidth * 0.8, behavior: "smooth" });
    };

    previousButton.addEventListener("click", () => scrollGrid(-1));
    nextButton.addEventListener("click", () => scrollGrid(1));
    grid.addEventListener("scroll", updateControls, { passive: true });
    window.addEventListener("resize", updateControls);
    updateControls();
  });
</script>
