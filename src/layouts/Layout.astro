---
import "../style/reset.css";
import "../style/variabless.css";
import "../style/global.css";
import HeadContent from "../components/HeadContent.astro";
import Header from "../components/Header.astro";

const { title, description, showHeader = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <HeadContent title={title} description={description} />
  </head>
  <body>
    <h1 class="sr-only">{title}</h1>
    {showHeader && <Header />}
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
</style>
