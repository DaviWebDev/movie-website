---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  path: string | ImageMetadata;
  alt: string;
  size?: "w342" | "w500" | "w780" | "original";
  width?: number;
  height?: number;
  type?: "poster" | "logo" | "profile";
  loading?: "lazy" | "eager";
  layout?: "constrained" | "full-width" | "none";
  source?: "tmdb" | "local";
  fetchpriority?: "low" | "high" | "auto";
}

const {
  path,
  alt = "",
  size = "w500",
  type,
  loading = "lazy",
  layout = "full-width",
  width,
  height,
  source = "tmdb",
  fetchpriority = "auto",
} = Astro.props;
const src = source === "local" ? path : `https://image.tmdb.org/t/p/${type === "logo" ? "original" : size}${path}`;

const dims = type === "poster" ? { width: 500, height: 750 } : { width: width!, height: height! };
---

{source === "local" ? (
  <Image src={path as ImageMetadata} alt={alt} {...dims} loading={loading} layout={layout} />
) : (
  <Image src={src as string} alt={alt} {...dims} loading={loading} layout={layout} fetchpriority={fetchpriority} />
)}
