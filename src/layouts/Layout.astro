---
import "../style/reset.css";
import "../style/variabless.css";
import "../style/global.css";
import HeadContent from "../components/HeadContent.astro";
import Header from "../components/Header.astro";

const { title, description, showHeader = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <HeadContent title={title} description={description} />
  </head>
  <body>
    {showHeader && <Header />}
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
</style>
